generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum WorkMode {
  OFFICE
  WFH
  HYBRID
  FIELD
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  employee         Employee?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  teams       Team[]
  employees   Employee[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model Team {
  id           String      @id @default(uuid())
  name         String
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  managerId    String?
  manager      Employee?   @relation("TeamManager", fields: [managerId], references: [id])
  members      Employee[]  @relation("TeamMembers")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([departmentId, name])
  @@map("teams")
}

model Employee {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String            @unique
  fullName         String
  designation      String?
  phone            String?
  departmentId     String?
  department       Department?       @relation(fields: [departmentId], references: [id])
  teamId           String?
  team             Team?             @relation("TeamMembers", fields: [teamId], references: [id])
  managerId        String?
  manager          Employee?         @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports     Employee[]       @relation("EmployeeManager")
  managedTeams     Team[]            @relation("TeamManager")
  joiningDate      DateTime?
  employmentStatus EmploymentStatus  @default(ACTIVE)
  workMode         WorkMode          @default(OFFICE)
  profilePhotoUrl  String?
  attendances      Attendance[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskAssigner")
  dailyUpdates     DailyUpdate[]     @relation("DailyUpdateAuthor")
  reviewedUpdates  DailyUpdate[]     @relation("DailyUpdateReviewer")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("employees")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DailyUpdateStatus {
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
}

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  checkInAt    DateTime
  checkOutAt   DateTime?
  workMode     WorkMode  @default(OFFICE)
  createdAt    DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(NOT_STARTED)
  completion   Int          @default(0)
  dueDate      DateTime?
  assigneeId   String
  assignee     Employee     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   Employee?    @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assigneeId])
  @@map("tasks")
}

model DailyUpdate {
  id            String            @id @default(uuid())
  employeeId    String
  employee      Employee          @relation("DailyUpdateAuthor", fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime          @db.Date
  summary       String
  blockers      String?
  tomorrowPlan  String?
  status        DailyUpdateStatus @default(SUBMITTED)
  reviewComment String?
  reviewedById  String?
  reviewedBy    Employee?         @relation("DailyUpdateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("daily_updates")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}
